{
  "name": "@robmine/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser-Client: Vite + three.js (WebGL2), Worker für Weltgen/Meshing/lokale Simulation, Debug-Overlay.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@robmine/content": "workspace:*",
    "@robmine/core": "workspace:*",
    "@robmine/protocol": "workspace:*",
    "@robmine/sim": "workspace:*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "vite": "8.3.5"
  }
}
